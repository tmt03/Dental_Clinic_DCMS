<?xml version="1.0" encoding="UTF-8"?>
<web-app version="2.5" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">
    <welcome-file-list>
        <welcome-file>home1.jsp</welcome-file>
    </welcome-file-list>
    <servlet>
        <servlet-name>viewPatientServlet</servlet-name>
        <servlet-class>controller.patientController.viewPatientServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ViewPatientDetailServlet</servlet-name>
        <servlet-class>controller.doctor.ViewPatientDetailServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>SearchEmployeeByName</servlet-name>
        <servlet-class>controller.admin.SearchEmployeeByName</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>viewMedicalAppointmentServlet</servlet-name>
        <servlet-class>controller.appointmentController.viewMedicalAppointmentServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AuthenticationFilter</servlet-name>
        <servlet-class>controller.AuthenticationFilter</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>viewPatientAppointment</servlet-name>
        <servlet-class>controller.patientController.viewPatientAppointment</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>UpdateAppointmentStatusServlet</servlet-name>
        <servlet-class>controller.appointmentController.UpdateAppointmentStatusServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>viewAppointmentNeedConfirmList</servlet-name>
        <servlet-class>controller.appointmentController.viewAppointmentNeedConfirmList</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>viewPatientServlet</servlet-name>
        <url-pattern>/viewpatient</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ViewPatientDetailServlet</servlet-name>
        <url-pattern>/viewpatientdetail</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SearchEmployeeByName</servlet-name>
        <url-pattern>/SearchEmployeeByName</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>viewMedicalAppointmentServlet</servlet-name>
        <url-pattern>/viewMedicalAppointment</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>viewPatientAppointment</servlet-name>
        <url-pattern>/viewPatientAppointment</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UpdateAppointmentStatusServlet</servlet-name>
        <url-pattern>/updateAppointmentStatus</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ajaxServlet</servlet-name>
        <servlet-class>com.vnpay.common.ajaxServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Config</servlet-name>
        <servlet-class>com.vnpay.common.Config</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>vnpayQuery</servlet-name>
        <servlet-class>com.vnpay.common.vnpayQuery</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>vnpayRefund</servlet-name>
        <servlet-class>com.vnpay.common.vnpayRefund</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ajaxServlet</servlet-name>
        <url-pattern>/vnpayajax/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Config</servlet-name>
        <url-pattern>/vnpayconfig/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>vnpayQuery</servlet-name>
        <url-pattern>/vnpayquery/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>vnpayRefund</servlet-name>
        <url-pattern>/vnpayrefund/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>viewAppointmentNeedConfirmList</servlet-name>
        <url-pattern>/viewNeedCf</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
